# Stage 1 - Build the frontend
FROM node:lts-alpine AS node-build-env

WORKDIR /src

RUN apk add --no-cache git python3 py3-pip make g++

COPY client/package*.json ./client/
RUN npm --prefix ./client ci

COPY client ./client
RUN npm --prefix ./client run build -- --output-path=out

# Stage 2 - Build the backend
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS dotnet-build-env

WORKDIR /src

COPY server ./server
RUN dotnet restore --no-cache ./server/RdtClient.sln
RUN dotnet test ./server/RdtClient.sln --no-restore
RUN dotnet publish ./server/RdtClient.Web/RdtClient.Web.csproj --no-restore -c Release -o /app/publish

# Stage 3 - Build the runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS runtime

WORKDIR /app

RUN mkdir -p /data/db /data/downloads && chown -R ${APP_UID}:${APP_UID} /app /data

COPY --from=dotnet-build-env /app/publish ./
COPY --from=node-build-env /src/client/out/browser ./wwwroot

EXPOSE 6500

USER ${APP_UID}

ENTRYPOINT ["dotnet", "RdtClient.Web.dll"]
